# Copy this file to .env and fill in your own values.
# All variables are optional; every one has a documented default.

# ---- Which GPUs the main process sees (e.g. "0" or "0,1") ----
# GBRAG_CUDA_DEVICES=0

# ---- Datasets to run (comma-separated, see dataset_map.py) ----
# GBRAG_DATASETS=GovReport_Geopolitics

# ---- LLM backend: ollama (default) or transformers ----
# GBRAG_LLM_BACKEND=ollama

# ---- Ollama endpoint (used when GBRAG_LLM_BACKEND=ollama) ----
# GBRAG_LLM_BASE_URL=http://localhost:8080
# GBRAG_LLM_MODEL=qwen2.5:14b
# GBRAG_LLM_TIMEOUT=300

# ---- Local HF model directory (used when GBRAG_LLM_BACKEND=transformers) ----
# GBRAG_LLM_MODEL_PATH=/path/to/your/llm
# GBRAG_LLM_DTYPE=auto
# GBRAG_LLM_DEVICE_MAP=auto
# GBRAG_LLM_MAX_MEM=
# GBRAG_LLM_8BIT=0
# GBRAG_LLM_SAMPLE=0

# ---- Model directories inside the repo ----
# GBRAG_EMBEDDING_MODEL_DIR=all-MiniLM-L6-v2
# GBRAG_PROPOSITIONIZER_DIR=chentong00/propositionizer-wiki-flan-t5-large

# ---- Evaluation devices ----
# GBRAG_EMBEDDING_DEVICE=cuda:0
# CONTEXT_METRIC_DEVICE=cuda:1

# ---- Batching / output ----
# GBRAG_BATCH_SIZE=50
# GBRAG_OUTPUT_ROOT=outputs
# GBRAG_STAGE=all           # "build" = graph building only, "all" = build + QA

# ---- Retrieval hyper-parameters (defaults reproduce the paper) ----
# GBRAG_V17_TOP_B=4
# GBRAG_V11_SCORE_KEEP=5
# GBRAG_V11_FINAL_KEEP=15
# GBRAG_V17_MAX_C_SEEDS=8
# GBRAG_V11_MAX_PATH_HOPS=4
# GBRAG_V11_MAX_PATH_COST=2.4
# GBRAG_V17_MIN_EDGE_SIM=0.35
# GBRAG_V17_TOP_K_CHUNKS=16
# GBRAG_V12_MIN_GATED_B=4
# GBRAG_V16_GLOBAL_B_SUPPLEMENT=4
# GBRAG_V18_MIDDLE_FACTS=3
# GBRAG_V18_ENTITY_C_FACTS=2
# GBRAG_V18_ENTITY_C_MAX_BALLS=0
# GBRAG_P1_MIN_PROPS=8
# GBRAG_P1_FALLBACK_MIN_SIM=0.45
# GBRAG_P1_FALLBACK_TOP_A=30
# GBRAG_P1_TOP_BRIDGE=10
# GBRAG_P1_BRIDGE_MIN_SIM=0.60

# ---- Single-module ablation switches (default 0 = full model) ----
# GBRAG_V18_NO_CHUNK_GATE=0
# GBRAG_V18_NO_ENTITY_C=0
# GBRAG_V18_NO_DOMAIN_BONUS=0
# GBRAG_V18_NO_PATH=0
# GBRAG_V18_NO_FALLBACK=0
# GBRAG_V18_NO_SUPP=0
# GBRAG_V18_SUPP_ONLY=0
# GBRAG_V18_NO_BRIDGE=0
# GBRAG_V18_NO_C_SUMMARY=0
# GBRAG_V18_FLAT=0
# GBRAG_V18_FLAT_TOP_K=32

# ---- Misc ----
# GBRAG_LLM_WORKERS=4
# GBRAG_ALLOW_CPU=0
# GBRAG_ANSWER_PROMPT_V6=0
